{
	"lexicon": 1,
	"id": "radio.4000.listBroadcasts",
	"defs": {
		"main": {
			"type": "query",
			"description": "Radios broadcasting now. Does not require auth.",
			"parameters": {
				"type": "params",
				"properties": {
					"limit": {
						"type": "integer",
						"minimum": 1,
						"maximum": 100,
						"default": 100
					},
					"cursor": {
						"type": "string"
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["broadcasts"],
					"properties": {
						"cursor": {
							"type": "string"
						},
						"broadcasts": {
							"type": "array",
							"items": {
								"type": "ref",
								"ref": "radio.4000.defs#broadcastView"
							}
						}
					}
				}
			}
		}
	}
}
