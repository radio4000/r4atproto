{
	"lexicon": 1,
	"id": "radio.4000.chat.message",
	"defs": {
		"main": {
			"type": "record",
			"description": "A message in the public chat room of a radio. Lives in the sender's repo.",
			"key": "tid",
			"record": {
				"type": "object",
				"required": ["subject", "text", "createdAt"],
				"properties": {
					"subject": {
						"type": "string",
						"format": "did",
						"description": "The radio whose room this is."
					},
					"text": {"type": "string", "maxLength": 3000, "maxGraphemes": 300},
					"createdAt": {"type": "string", "format": "datetime"}
				}
			}
		}
	}
}
