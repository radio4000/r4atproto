{
	"lexicon": 1,
	"id": "radio.4000.chat.listMessages",
	"defs": {
		"main": {
			"type": "query",
			"description": "Messages of a radio's chat room, newest first. Does not require auth.",
			"parameters": {
				"type": "params",
				"properties": {
					"radio": {
						"type": "string",
						"format": "did"
					},
					"limit": {
						"type": "integer",
						"minimum": 1,
						"maximum": 100,
						"default": 50
					},
					"cursor": {
						"type": "string"
					}
				},
				"required": ["radio"]
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["messages"],
					"properties": {
						"cursor": {
							"type": "string"
						},
						"messages": {
							"type": "array",
							"items": {
								"type": "ref",
								"ref": "radio.4000.defs#chatMessageView"
							}
						}
					}
				}
			}
		}
	}
}
