{
	"lexicon": 1,
	"id": "radio.4000.broadcast",
	"defs": {
		"main": {
			"type": "record",
			"description": "What a radio plays live, deck by deck. Exists only while broadcasting; updatedAt doubles as a heartbeat.",
			"key": "literal:self",
			"record": {
				"type": "object",
				"required": ["decks", "updatedAt"],
				"properties": {
					"decks": {"type": "array", "maxLength": 8, "items": {"type": "ref", "ref": "#deck"}},
					"updatedAt": {"type": "string", "format": "datetime"}
				}
			}
		},
		"deck": {
			"type": "object",
			"required": ["track", "url", "positionMs", "positionAt", "playing"],
			"properties": {
				"track": {
					"type": "string",
					"description": "The radio.4000.track record (at:// URI), or another id for tracks without a record.",
					"maxLength": 512
				},
				"url": {"type": "string", "format": "uri", "maxLength": 2048},
				"title": {"type": "string", "maxLength": 3000, "maxGraphemes": 300},
				"positionMs": {
					"type": "integer",
					"description": "Playback position in milliseconds at positionAt.",
					"minimum": 0
				},
				"positionAt": {"type": "string", "format": "datetime"},
				"playing": {"type": "boolean"},
				"speed": {
					"type": "integer",
					"description": "Playback rate in percent.",
					"minimum": 25,
					"maximum": 400,
					"default": 100
				}
			}
		}
	}
}
