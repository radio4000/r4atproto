{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"paths": {"#lib/*": ["./src/lib/*"]},
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": false,
		"useUnknownInCatchVariables": false,
		"types": ["$app/types", "youtube"]
	},
	"include": ["src", "vite.config.ts"]
}
