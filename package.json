{
	"name": "4000.radio",
	"version": "0.0.1",
	"description": "Radio4000 on the AT Protocol: curate, showcase and explore lists of media",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:cloudflare": "vite build",
		"preview": "vite preview",
		"deploy:wrangler": "wrangler deploy",
		"test": "vitest run",
		"types": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"format": "prettier --write . --log-level=warn",
		"biome": "biome check --write .",
		"lint": "eslint .",
		"check": "bun run format && bun run biome && bun run lint",
		"knip": "knip-bun",
		"i18n": "node i18n/sync.js && bunx @inlang/paraglide-js compile --project ./i18n/project.inlang --outdir ./src/lib/paraglide",
		"i18n:stats": "node i18n/stats.js",
		"i18n:extract": "node i18n/extract.js",
		"i18n:review": "node i18n/review.js",
		"i18n:check": "node i18n/check.js",
		"i18n:prune-unused": "node i18n/prune-unused.js",
		"i18n:apply": "node i18n/apply-batch.js"
	},
	"dependencies": {
		"@atproto/api": "^0.29.4",
		"@atproto/common-web": "^0.5.15",
		"@atproto/oauth-client-browser": "^0.5.10",
		"@atproto/oauth-types": "^0.7.7",
		"@humanspeak/svelte-virtual-list": "^0.5.15",
		"@inlang/paraglide-js": "^2.29.1",
		"@tanstack/db": "^0.15.2",
		"@tanstack/query-core": "^5.104.5",
		"@tanstack/query-db-collection": "^1.4.8",
		"@tanstack/svelte-db": "^0.5.12",
		"fuzzysort": "^4.0.2",
		"lucide-svelte": "^0.554.0",
		"media-chrome": "^4.19.4",
		"media-now": "^2.2.3",
		"obra-icons-svelte": "^1.25.0",
		"runed": "^0.38.0",
		"tinykeys": "^4.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^0.554.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"@types/youtube": "^0.3.0",
		"@typescript/native": "^7.0.2",
		"autoprefixer": "^10.4.21",
		"bits-ui": "^1.8.0",
		"clsx": "^2.1.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.4",
		"knip": "^6.42.1",
		"postcss": "^8.5.6",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"shadcn-svelte": "^1.0.9",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^0.2.1",
		"tailwindcss": "^3.4.10",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	},
	"repository": "https://github.com/radio4000/r4atproto",
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
